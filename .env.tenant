# =============================================================================
#  vxnode / valtunox — single source of truth for every env var the binary reads
#
#  Layout matches the runtime lookups in:
#    - main.go                (server + auth)
#    - config/config.go       (backend endpoints, Redis)
#    - config/vault.go        (Vault, Consul)
#    - config/model_registry.go / config/model_manager.go (AI providers)
#    - services/billings/, services/kubernetes/, services/vxchrono/
#    - services/cli/cmd/providers/* (OpenClaw, OpenAI, Anthropic, Google)
#
#  Rules:
#    1. .env, .env.*, *.env are excluded by .dockerignore — never baked into
#       the image. docker-compose mounts this file at runtime via env_file.
#    2. Leave a key blank ("") rather than removing it — the comment IS the
#       documentation for that knob.
#    3. Per-tenant AI keys should live in Vault under
#         secret/data/workspaces/<org>/<user>/ai/<provider>/credentials
#       (BYOK). The values below are LAST-RESORT fallbacks only.
# =============================================================================

# ── SERVER ──────────────────────────────────────────────────────────────────
VAULT_TOKEN=""
DEVELOPER_API_KEY=""
PORT=8744
GIN_MODE=release
SERVER_MODE=debug
TERRAFORM_PATH=/generated/
TLS_CERT_FILE=
TLS_KEY_FILE=
WORKSPACE_BASE_PATH=/workspaces
APP_ENV=development
# ── BUILT-IN AUTH (middlewares in main.go) ──────────────────────────────────
# No defaults in source anymore — these MUST be set or the middlewares refuse.
API_USERNAME=vxcloud
API_PASSWORD=vxcloud
SECRET_KEY_MASTER=vxcloud

# ── INTERNAL SERVICES ───────────────────────────────────────────────────────
# VxCloud AI / FastAPI persistence layer — used by services/billings &
# services/kubernetes. Code now reads VXCLOUD_API_URL (was hardcoded).
VXCLOUD_API_URL=https://api.vxcloud.io
# AI health probe (main.go checkVxCloudAI). Code reads VXCLOUD_URL.
VXCLOUD_URL=https://api.vxcloud.io/health
# VxChrono → workflow bridge (services/vxchrono/adapters.go)
VXCHRONO_WORKFLOW_URL=https://cloud.vxcloud.io/api/v2/workflow/execute
# OAuth app URL (services/cli/cmd/auth_oauth.go)
VX_APP_URL=https://app.vxcloud.io

# ── CORE BACKEND / FASTAPI / LIFECYCLE WEBHOOKS ─────────────────────────────
CORE_BACKEND_URL="https://api.vxcloud.io"
FASTAPI_BASE_URL="https://api.vxcloud.io"
FASTAPI_SERVICE_TOKEN=
DEPLOYMENT_STATUS_ENDPOINT="https://api.vxcloud.io/api/v1/infrastructure/services/tenant/provision/deployment/status/"
UPDATE_CODE_ENDPOINT="https://api.vxcloud.io/api/v3/tenant/provision/operation/update-code"
QUICK_START_ENDPOINT="https://api.vxcloud.io/api/v3/infrastructure/services/tenant/provision/quick/start/"
FULL_UPDATE_ENDPOINT="https://api.vxcloud.io/api/v3/tenant/provision/operation/full-update"

# ── TENANT IDENTITY ─────────────────────────────────────────────────────────
TENANT_ID=""
TENANT_NAME=""
TENANT_ORGANIZATION=""
TENANT_WORKSPACE=""

# ── VAULT ───────────────────────────────────────────────────────────────────
# Core servers use VAULT_TOKEN (root). Tenant VMs use VAULT_ROLE_ID +
# VAULT_SECRET_ID (scoped AppRole). Do not set both on a tenant VM.
VAULT_ADDR="https://vault.vxcloud.io"
CONSUL_ADDR=http://consul.vxcloud.io
VAULT_ROLE_ID=""
VAULT_SECRET_ID=""

# ── REDIS (optional — currently disabled; Vault holds credentials) ─────────
REDIS_URL=http://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── VaLLM (internal) ────────────────────────────────────────────────────────
VA_LLM_URL=http://llm.vxcloud.io:8745
VA_LLM_MODEL=va_llm_v1
VA_LLM_TOKEN=

# ── SOURCE CONTROL (GitHub / GHE) ───────────────────────────────────────────
# Override for GitHub Enterprise installations
# (e.g. https://github.acme.com/api/v3). Default: https://api.github.com
GITHUB_API_URL=


# =============================================================================
#  AI PROVIDERS — global defaults (BYOK overrides at the workspace level)
# =============================================================================

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Google (Gemini) ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-pro-preview
GEMINI_MODEL=gemini-3.1-pro-preview
# GOOGLE_PROJECT_ID is only needed for Vertex AI; the API-key (generativelanguage) path ignores it.
# Was a placeholder ("dsfsdf") which could leak into gcloud CLOUDSDK_CORE_PROJECT — left empty until a real project id is set.
GOOGLE_PROJECT_ID=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# ── VXCOMPUTER agent runtime LLM provider ───────────────────────────────────
# anthropic (default) | openai | gemini. Selects which model the node's
# Plan→Act→Reflect loop calls. Set to gemini to use the keys above.
VXCOMPUTER_LLM_PROVIDER=gemini

# ── Azure OpenAI ────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_MODEL=gpt-4o-mini

# ── DeepSeek ────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-coder

# ── Qwen / DashScope (Alibaba) ──────────────────────────────────────────────
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max

# ── MiniMax ─────────────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# ── Kimi / Moonshot ─────────────────────────────────────────────────────────
KIMI_API_KEY=
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-32k

# ── HuggingFace ─────────────────────────────────────────────────────────────
HF_TOKEN=
HUGGINGFACE_API_KEY=
HF_LOCAL_MODEL=Qwen/Qwen2.5-3B-Instruct

# ── Ollama (local LLM runtime) ──────────────────────────────────────────────
# OLLAMA_HOST MUST include scheme (http://) and port (default 11434).
# Bare "localhost" silently breaks routing because the code falls back to the
# canonical OpenAI base URL when scheme parsing fails.
OLLAMA_HOST=localhost
OLLAMA_MODEL=llama3.2:latest

# ── Local ASR ───────────────────────────────────────────────────────────────
LOCAL_ASR_MODEL=faster-whisper-base

# =============================================================================
#  SEARCH / GROUNDING PROVIDERS
# =============================================================================

# ── Brave Search ────────────────────────────────────────────────────────────
# X-Subscription-Token from https://api-dashboard.search.brave.com.
# ENDPOINT: web (default) | llm-context | chat
BRAVE_API_KEY=
BRAVE_BASE_URL=https://api.search.brave.com
BRAVE_ENDPOINT=web

# =============================================================================
#  PROPRIETARY / SELF-HOSTED AI
# =============================================================================

# ── OpenClaw Gateway ────────────────────────────────────────────────────────
# Bearer token MUST be set explicitly — no hardcoded default in source anymore.
# TELEGRAM_CHANNEL + TELEGRAM_TOKEN pair the bot to a Telegram channel for
# kill-switch / notification routing (BotFather token + @channel or chat_id).
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_AGENT=openclaw/default
OPENCLAW_MODEL=
OPENCLAW_TELEGRAM_CHANNEL=
OPENCLAW_TELEGRAM_TOKEN=

# ── Hermes Agent (Nous Research) ────────────────────────────────────────────
# Multi-provider agent runtime. API_KEY is the API_SERVER_KEY bearer of the
# hermes-agent server (or Nous Portal token). DEFAULT_PROVIDER picks which
# upstream Hermes routes to: openrouter | nous | anthropic | gemini | qwen |
# deepseek | xai | bedrock | huggingface | …
HERMES_API_KEY=
HERMES_API_URL=
HERMES_DEFAULT_PROVIDER=
HERMES_MODEL=hermes-3-llama-3.1-405b

